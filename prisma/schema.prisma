generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  AGENT
}

enum PartyType {
  AGENT
  BROKER
}

enum CommissionType {
  PERCENT
  FIXED
}

enum CashHandlingType {
  HOLD
  TAKE_HOME
}

enum NotificationType {
  MISSING_SALES
  UNACCESSED_EVENT
}

enum AttachmentEntityType {
  VENUE
  EVENT
}

model Tenant {
  id        String   @id @default(uuid())
  name      String   @unique
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())

  users       User[]
  agencies    Agency[]
  intermediaries Intermediary[]
  venues      Venue[]
  events      Event[]
  eventDays   EventDay[]
  sales       Sale[]
  accesses    Access[]
  notifications Notification[]
  attachments Attachment[]
}

model User {
  id                 String   @id @default(uuid())
  authUserId         String?  @unique
  tenantId           String?
  agencyId           String?
  email              String   @unique
  passwordHash       String
  role               UserRole
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())

  tenant  Tenant? @relation(fields: [tenantId], references: [id])
  agency  Agency? @relation(fields: [agencyId], references: [id])
  sessions Session[]
  accesses Access[]
  attachments Attachment[]
  salesCreated Sale[]
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Agency {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  email     String?
  shopName  String?
  passwordHash String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  events Event[]
  users  User[]
  sales  Sale[]
}

model Intermediary {
  id            String   @id @default(uuid())
  tenantId      String
  name          String
  reportFormUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  events Event[]
  venues Venue[]
}

model Venue {
  id                String   @id @default(uuid())
  tenantId          String
  intermediaryId    String?
  name              String
  address           String?
  note              String?
  attachmentUrl     String?
  phone             String?
  contactName       String?
  trashRule         String?
  cashHandling      CashHandlingType?
  notes             String?
  hours             String?
  workWindow        String?
  loadInTime        String?
  loadOutTime       String?
  preContactRequired Boolean @default(false)
  brokerNote        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  intermediary Intermediary? @relation(fields: [intermediaryId], references: [id])
  events Event[]
}

model Event {
  id            String   @id @default(uuid())
  tenantId      String
  agencyId      String
  venueId       String
  intermediaryId String?
  title         String
  startDate     DateTime
  endDate       DateTime
  reportDeadline String?
  cashHandling  CashHandlingType?
  memo          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  agency   Agency? @relation(fields: [agencyId], references: [id])
  venue    Venue? @relation(fields: [venueId], references: [id])
  intermediary Intermediary? @relation(fields: [intermediaryId], references: [id])
  eventDays EventDay[]
  sales    Sale[]
  accesses Access[]
}

model EventDay {
  id              String   @id @default(uuid())
  tenantId        String
  eventId         String
  date            DateTime
  brokerCompleted Boolean  @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  event  Event  @relation(fields: [eventId], references: [id])

  @@unique([eventId, date])
}

model Sale {
  id              String   @id @default(uuid())
  tenantId        String
  eventId         String
  agencyId        String
  date            DateTime
  amount          Float

  // ★ 追加（route.ts が使っている列）
  createdByUserId String
  partyType       PartyType
  commissionType  CommissionType
  commissionValue Float    @default(0)
  parkingFee      Float    @default(0)
  managerName     String   @default("")
  memoAppendOnly  String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  event  Event  @relation(fields: [eventId], references: [id])
  agency Agency @relation(fields: [agencyId], references: [id])
  createdBy User @relation(fields: [createdByUserId], references: [id])

  @@unique([eventId, date])
}

model Access {
  id        String   @id @default(uuid())
  tenantId  String
  eventId   String
  userId    String
  accessedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  event  Event  @relation(fields: [eventId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
}

model Notification {
  id         String           @id @default(uuid())
  tenantId   String
  type       NotificationType
  targetDate DateTime
  refId      String
  isClosed   Boolean          @default(false)
  createdAt  DateTime         @default(now())
  closedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model Attachment {
  id            String   @id @default(uuid())
  tenantId      String
  entityType    AttachmentEntityType
  entityId      String
  blobUrl       String?
  driveFileId   String?
  driveWebViewLink String?
  filename      String
  contentType   String
  size          Int
  uploadedByUserId String
  createdAt     DateTime @default(now())
  deletedAt     DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  uploadedBy User @relation(fields: [uploadedByUserId], references: [id])
}
