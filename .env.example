DATABASE_URL=postgresql://<user>:<pass>@localhost:6543/<db>
DIRECT_URL=postgresql://<user>:<pass>@localhost:5432/<db>
FILE_STORAGE_PROVIDER=blob
XRULE_TENANT_ID=

# Vercel Postgres / Supabase examples:
# POSTGRES_PRISMA_URL=postgresql://<user>:<pass>@<host>:5432/<db>
# POSTGRES_URL_NON_POOLING=postgresql://<user>:<pass>@<host>:5432/<db>
# Supabase pooler notes:
# - DATABASE_URL should point to pooler Transaction mode (usually port 6543)
# - DIRECT_URL should point to pooler Session mode (usually port 5432)
# - Direct host (db.<project-ref>.supabase.co) requires IPv6 or IPv4 add-on
