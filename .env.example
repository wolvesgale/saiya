# ==============================
# Prisma / Supabase (required)
# ==============================
# Runtime queries (pooled): Supabase Transaction pooler URL (port 6543)
# - append pgbouncer=true for Prisma
# - connection_limit=1 is recommended for serverless
POSTGRES_PRISMA_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Prisma migrate / db push (direct): Supabase direct URL (port 5432)
# IMPORTANT: use db.<project-ref>.supabase.co host for direct connection.
POSTGRES_URL_NON_POOLING=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# Optional aliases used by runtime fallback logic (can be omitted when above two are set)
DATABASE_URL=
DIRECT_URL=

# Deprecated in this repo. Do not use new values.
POSTGRES_URL=

# ==============================
# App settings
# ==============================
FILE_STORAGE_PROVIDER=blob
XRULE_TENANT_ID=

# ==============================
# Cron jobs (required on Vercel)
# ==============================
# Set a random secret string (e.g. openssl rand -hex 32).
# Vercel automatically passes this as "Authorization: Bearer <secret>"
# when invoking cron endpoints defined in vercel.json.
# Without this, all cron jobs will return 500 and no syncs will run.
CRON_SECRET=

# ==============================
# Supabase API keys
# ==============================
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY= # Public anon key (safe to expose client-side)
SUPABASE_SERVICE_ROLE_KEY=      # Secret: set from Supabase dashboard
SUPABASE_SECRET_KEY=            # Secret: set from Supabase dashboard
SUPABASE_JWT_SECRET=            # Secret: set from Supabase dashboard

# ==============================
# Blob storage
# ==============================
BLOB_READ_WRITE_TOKEN=

# ==============================
# Google Sheets / Drive
# ==============================
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_SHEETS_SCOPE=https://www.googleapis.com/auth/spreadsheets
GOOGLE_DRIVE_FOLDER_ID=

# ==============================
# Mail (optional)
# ==============================
EMAIL_PROVIDER=console
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM=
