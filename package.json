{
  "name": "saiya",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run prisma:env:check && node scripts/prisma-command.mjs migrate deploy && prisma generate && next build",
    "postinstall": "prisma generate",
    "vercel-build": "npm run prisma:env:check && bash scripts/vercel-build.sh",
    "start": "next start",
    "lint": "next lint",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "node scripts/prisma-command.mjs migrate dev",
    "prisma:migrate:deploy": "node scripts/prisma-command.mjs migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "ts-node --esm prisma/seed.ts",
    "prisma:migrate:status": "node scripts/prisma-command.mjs migrate status",
    "prisma:migrate:resolve:rolledback": "node scripts/prisma-command.mjs migrate resolve --rolled-back 20260211100000_add_venue_agency_id",
    "prisma:migrate:resolve:applied": "node scripts/prisma-command.mjs migrate resolve --applied 20260211100000_add_venue_agency_id",
    "prisma:migrate:resolve:rolledback:intermediary": "node scripts/prisma-command.mjs migrate resolve --rolled-back 20260220000000_venue_use_intermediary_id",
    "prisma:migrate:resolve:applied:intermediary": "node scripts/prisma-command.mjs migrate resolve --applied 20260220000000_venue_use_intermediary_id",
    "prisma:env:check": "node scripts/check-env.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.637.0",
    "@prisma/client": "^5.22.0",
    "@vercel/blob": "^2.3.3",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "googleapis": "^144.0.0",
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
